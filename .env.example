# 复制为 .env 后按需修改（.env 不要提交到 git）
# Web 服务端口
PORT=8000
# 时区（日报按此时区的自然天划分）
TZ=Asia/Shanghai
# 抓取间隔（小时）。默认 4 小时；不要调太激进，避免给源站造成压力
FETCH_INTERVAL_HOURS=4
# 数据目录：SQLite 文件会存放在此目录下（默认 仓库根目录/data）
DATA_DIR=./data

# —— 高级/容器用 ——
# 直接指定数据库文件路径（设置后优先于 DATA_DIR；docker-compose 里固定为 /data/news.db）
# DB_PATH=/data/news.db
